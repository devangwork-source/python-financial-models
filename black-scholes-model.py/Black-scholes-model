def run_volatility_forecast_section(prices):
    returns = prices.pct_change().dropna().values
    train_returns = returns[:int(len(returns)*0.7)]  # rough split; adjust to TRAIN/TEST dates if preferred

    print("="*60)
    print("SECTION 1: GARCH(1,1) vs HISTORICAL VOL -- WALK-FORWARD EVALUATION")
    print("="*60)
    print(f"Window={VOL_WINDOW}d, horizon={VOL_HORIZON}d, step={VOL_STEP}d "
          f"(this can take a few minutes locally)")
    g_err, h_err, origins = walk_forward_vol_eval(returns)
    print(f"Forecast origins evaluated: {len(g_err)}")
    print(f"Mean |GARCH error|:      {np.mean(np.abs(g_err)):.5f}")
    print(f"Mean |Historical error|: {np.mean(np.abs(h_err)):.5f}")

    dm = diebold_mariano_test(g_err, h_err, h=VOL_HORIZON)
    print(f"\nDiebold-Mariano test (H0: equal forecast accuracy):")
    print(f"  DM statistic: {dm['dm_stat']:.3f}")
    print(f"  p-value:      {dm['p_value']:.4f}")
    print(f"  Mean loss diff (GARCH - Hist, squared error): {dm['mean_loss_diff']:.6f}")
    if dm['p_value'] < 0.05:
        winner = "GARCH" if dm['mean_loss_diff'] < 0 else "Historical"
        conclusion = f"Reject H0 at 5%: {winner} has significantly lower forecast error."
    else:
        conclusion = ("Fail to reject H0: no statistically significant difference in "
                       "forecast accuracy between GARCH(1,1) and naive historical volatility.")
    print(f"  -> {conclusion}")

    # ---- persist results so they're visible without re-running ----
    with open('garch_vs_historical_results.txt', 'w') as f:
        f.write("GARCH(1,1) vs Historical Volatility -- Walk-Forward Evaluation\n")
        f.write("="*65 + "\n")
        f.write(f"Underlying: {UNDERLYING}\n")
        f.write(f"Run date:   {pd.Timestamp.now().strftime('%Y-%m-%d %H:%M')}\n")
        f.write(f"Window={VOL_WINDOW}d, horizon={VOL_HORIZON}d, step={VOL_STEP}d\n")
        f.write(f"Forecast origins evaluated: {len(g_err)}\n\n")
        f.write(f"Mean |GARCH error|:      {np.mean(np.abs(g_err)):.5f}\n")
        f.write(f"Mean |Historical error|: {np.mean(np.abs(h_err)):.5f}\n\n")
        f.write("Diebold-Mariano test (H0: equal forecast accuracy):\n")
        f.write(f"  DM statistic: {dm['dm_stat']:.3f}\n")
        f.write(f"  p-value:      {dm['p_value']:.4f}\n")
        f.write(f"  Mean loss diff (GARCH - Hist, squared error): {dm['mean_loss_diff']:.6f}\n")
        f.write(f"  -> {conclusion}\n")
    print("\nResults saved to garch_vs_historical_results.txt")

    plt.figure(figsize=(9, 5))
    plt.plot(origins, np.abs(g_err), label='|GARCH forecast error|', marker='o', ms=3)
    plt.plot(origins, np.abs(h_err), label='|Historical forecast error|', marker='o', ms=3)
    plt.xlabel('Forecast origin (trading day index)')
    plt.ylabel('Absolute volatility forecast error')
    plt.title(f'{UNDERLYING}: GARCH(1,1) vs Historical Vol Forecast Error\n'
              f'DM p-value = {dm["p_value"]:.3f}')
    plt.legend()
    plt.tight_layout()
    plt.savefig('garch_vs_historical.png', dpi=100)
    print("Chart saved to garch_vs_historical.png")

    return g_err, h_err, origins, returns


def run_multi_stock_robustness(tickers=ROBUSTNESS_TICKERS, start=START, end=TEST_END):
    """
    Repeats the GARCH vs historical-vol walk-forward test across multiple
    stocks to check whether the finding on the primary UNDERLYING (no
    significant GARCH advantage) is consistent, or specific to one name.
    """
    print("\n" + "="*60)
    print("MULTI-STOCK ROBUSTNESS CHECK")
    print("="*60)
    rows = []
    for ticker in tickers:
        print(f"\n--- {ticker} ---")
        prices = load_price_history(ticker, start, end)
        returns = prices.pct_change().dropna().values
        g_err, h_err, origins = walk_forward_vol_eval(returns)
        dm = diebold_mariano_test(g_err, h_err, h=VOL_HORIZON)
        print(f"  n_origins={len(g_err)}  mean|GARCH err|={np.mean(np.abs(g_err)):.5f}  "
              f"mean|Hist err|={np.mean(np.abs(h_err)):.5f}  "
              f"DM={dm['dm_stat']:.3f}  p={dm['p_value']:.4f}")
        rows.append({
            'ticker': ticker, 'n_origins': len(g_err),
            'mean_abs_garch_err': np.mean(np.abs(g_err)),
            'mean_abs_hist_err': np.mean(np.abs(h_err)),
            'dm_stat': dm['dm_stat'], 'p_value': dm['p_value'],
            'significant_at_5pct': dm['p_value'] < 0.05
        })

    summary = pd.DataFrame(rows)
    print("\nSUMMARY ACROSS STOCKS:")
    print(summary.to_string(index=False))
    n_sig = summary['significant_at_5pct'].sum()
    print(f"\n{n_sig} of {len(summary)} stocks show a statistically significant "
          f"GARCH vs historical-vol difference at the 5% level.")

    summary.to_csv('garch_robustness_summary.csv', index=False)
    print("Summary saved to garch_robustness_summary.csv")

    plt.figure(figsize=(8, 5))
    colors = ['crimson' if sig else 'steelblue' for sig in summary['significant_at_5pct']]
    plt.bar(summary['ticker'], summary['p_value'], color=colors)
    plt.axhline(0.05, color='gray', linestyle='--', label='p = 0.05 threshold')
    plt.ylabel('Diebold-Mariano p-value')
    plt.title('GARCH vs Historical Vol: Significance Across Stocks')
    plt.legend()
    plt.tight_layout()
    plt.savefig('garch_robustness.png', dpi=100)
    print("Chart saved to garch_robustness.png")

    return summary


def run_smile_section(option_chain_csv, S, T, r):
    print("\n" + "="*60)
    print("SECTION 2: IMPLIED VOLATILITY SMILE + SIGNIFICANCE TEST")
    print("="*60)
    chain = build_smile(option_chain_csv, S, T, r)
    print(chain[['strike', 'option_type', 'market_price', 'iv']])

    reg = smile_regression(chain['strike'].values, chain['iv'].values, S)
    print(f"\nRegression: IV ~ intercept + skew*moneyness + curvature*moneyness^2")
    print(f"  Intercept (ATM-ish IV level): {reg['intercept']:.4f}")
    print(f"  Skew coefficient:    {reg['skew_coef']:.4f}  (p={reg['skew_p']:.4f})")
    print(f"  Curvature coefficient: {reg['curvature_coef']:.4f}  (p={reg['curvature_p']:.4f})")
    print(f"  R^2: {reg['r2']:.4f}")
    if reg['skew_p'] < 0.05 or reg['curvature_p'] < 0.05:
        print("  -> Reject H0: implied volatility varies significantly across strikes.")
        print("     This empirically confirms Black-Scholes' constant-volatility")
        print("     assumption does not hold for this option chain.")
    else:
        print("  -> Fail to reject H0: no statistically significant smile/skew detected")
        print("     in this chain (may reflect low liquidity / wide bid-ask, or a")
        print("     genuinely flat vol surface for this underlying/expiry).")

    plt.figure(figsize=(8,5))
    plt.scatter(chain['strike'], chain['iv'], label='Market-implied IV')
    plt.xlabel('Strike'); plt.ylabel('Implied Volatility'); plt.title('Volatility Smile/Skew')
    plt.axvline(S, color='gray', linestyle='--', label='Spot')
    plt.legend()
    plt.tight_layout()
    plt.savefig('vol_smile.png', dpi=100)
    print("\nSmile chart saved to vol_smile.png")
    return chain, reg


