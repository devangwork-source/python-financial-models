import numpy as np

def monte_carlo_portfolio(S0, mu, sigma, corr_matrix, weights, T, steps, simulations):
    
    dt = T / steps
    n_assets = len(S0)
    
    chol = np.linalg.cholesky(corr_matrix)
    
    portfolio_values = np.zeros((steps, simulations))
    
    prices = np.zeros((steps, simulations, n_assets))
    prices[0] = S0
    
    for t in range(1, steps):
        Z = np.random.standard_normal((simulations, n_assets))
        correlated_Z = Z @ chol.T
        
        for i in range(n_assets):
            prices[t,:,i] = prices[t-1,:,i] * np.exp(
                (mu[i] - 0.5 * sigma[i]**2) * dt
                + sigma[i] * np.sqrt(dt) * correlated_Z[:,i]
            )
        
        portfolio_values[t] = np.sum(prices[t] * weights, axis=1)
    
    return portfolio_values


# Example
S0 = np.array([100, 200])
mu = np.array([0.10, 0.08])
sigma = np.array([0.20, 0.25])
corr_matrix = np.array([[1.0, 0.3],
                        [0.3, 1.0]])
weights = np.array([0.5, 0.5])

portfolio_paths = monte_carlo_portfolio(
    S0, mu, sigma, corr_matrix, weights,
    T=1, steps=252, simulations=1000
)

final_portfolio = portfolio_paths[-1]

print("Expected Portfolio Value:", np.mean(final_portfolio))
print("Portfolio VaR (5%):", np.percentile(final_portfolio, 5))