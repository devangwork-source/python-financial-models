"""
Project 1: Portfolio Optimization & Risk Simulation
Markowitz optimization (exact + sampled) + out-of-sample backtest
+ Monte Carlo / Parametric / Historical VaR comparison
+ Block-bootstrap hypothesis test on the out-of-sample Sharpe gap
+ Jarque-Bera normality check on portfolio returns.

Run locally (needs internet access for yfinance).
"""

import numpy as np
import pandas as pd
import yfinance as yf
from scipy.optimize import minimize
from scipy import stats
import matplotlib.pyplot as plt

# ============================================================
# CONFIG
# ============================================================
STOCKS      = ['RELIANCE.NS', 'TCS.NS', 'INFY.NS', 'HDFCBANK.NS', 'PIIND.NS']
START       = "2020-01-01"
TRAIN_END   = "2023-12-31"
TEST_START  = "2024-01-01"
TEST_END    = "2025-04-01"
RISK_FREE   = 0.065          # annualized, India repo-rate proxy
INITIAL_INVESTMENT = 100000  # Rs 1,00,000
NUM_RANDOM_PORTFOLIOS = 10000
MC_SIMULATIONS = 10000
MC_DAYS = 30                  # 30-day forward VaR horizon
CONFIDENCE = 0.95
SEED = 42
BOOTSTRAP_BLOCK_SIZE = 10     # days per block in the Sharpe-diff bootstrap
BOOTSTRAP_ITERS = 5000

np.random.seed(SEED)

# ============================================================
# 1. DATA
# ============================================================
def load_data(use_live=True, csv_path=None):
    if use_live:
        raw = yf.download(STOCKS, start=START, end=TEST_END)['Close']
    else:
        raw = pd.read_csv(csv_path, index_col=0, parse_dates=True)
    raw = raw.dropna(axis=1, thresh=int(0.95 * len(raw)))   # drop tickers missing >5% history
    raw = raw.dropna()
    return raw


# ============================================================
# HYPOTHESIS TESTING HELPERS
# ============================================================
def block_bootstrap_sharpe_diff(returns_a, returns_b, rf, block_size=10,
                                  n_boot=5000, seed=42):
    """
    Circular block bootstrap test for whether the annualized Sharpe ratio of
    portfolio A differs from portfolio B, using paired daily return series
    (same dates) to preserve cross-portfolio correlation and each series'
    own autocorrelation structure.

    H0: Sharpe(A) - Sharpe(B) = 0   (the observed gap is noise)
    H1: Sharpe(A) - Sharpe(B) != 0  (two-sided -- the gap is real)

    Block (not single-day) resampling preserves autocorrelation in returns
    that a naive iid bootstrap would destroy.
    """
    rng = np.random.default_rng(seed)
    a = np.asarray(returns_a)
    b = np.asarray(returns_b)
    n = len(a)
    n_blocks = int(np.ceil(n / block_size))

    def ann_sharpe(r):
        mean = r.mean() * 252
        vol = r.std() * np.sqrt(252)
        return (mean - rf) / vol

    observed_diff = ann_sharpe(a) - ann_sharpe(b)

    diffs = np.empty(n_boot)
    for i in range(n_boot):
        starts = rng.integers(0, n, size=n_blocks)
        idx = np.concatenate([np.arange(s, s + block_size) % n for s in starts])[:n]
        diffs[i] = ann_sharpe(a[idx]) - ann_sharpe(b[idx])

    ci_low, ci_high = np.percentile(diffs, [2.5, 97.5])
    p_value = min(2 * min((diffs <= 0).mean(), (diffs >= 0).mean()), 1.0)

    return {'observed_diff': observed_diff, 'ci_95': (ci_low, ci_high),
            'p_value': p_value, 'boot_diffs': diffs}


def normality_check(returns, label=""):
    """
    Jarque-Bera test for normality. Explains *why* the three VaR methods
    converge: Parametric VaR assumes normally distributed returns, so this
    test tells you whether that assumption actually holds for this
    portfolio, rather than just observing the three numbers are close.
    """
    jb_stat, jb_p = stats.jarque_bera(np.asarray(returns))
    print(f"Jarque-Bera test ({label}): stat={jb_stat:.2f}, p={jb_p:.4f}")
    if jb_p < 0.05:
        print("  -> Reject normality at 5% (returns show excess skew/kurtosis)")
    else:
        print("  -> Fail to reject normality at 5% (consistent with near-normal returns,")
        print("     which is why Parametric VaR agrees closely with the other two methods)")
    return jb_stat, jb_p


def run(raw):
    stocks = list(raw.columns)
    n_assets = len(stocks)
    print(f"Using {n_assets} assets: {stocks}")
    print(f"Data range: {raw.index.min().date()} to {raw.index.max().date()}  ({len(raw)} trading days)")

    train_prices = raw[raw.index <= TRAIN_END]
    test_prices  = raw[(raw.index >= TEST_START) & (raw.index <= TEST_END)]

    train_returns = train_prices.pct_change().dropna()
    test_returns  = test_prices.pct_change().dropna()

    mean_returns = train_returns.mean()
    cov_matrix   = train_returns.cov()
    corr_matrix  = train_returns.corr()

    print(f"Training period: {train_returns.index.min().date()} to {train_returns.index.max().date()}  ({len(train_returns)} days)")
    print(f"Test period:     {test_returns.index.min().date()} to {test_returns.index.max().date()}  ({len(test_returns)} days)")

    # ============================================================
    # 2. PORTFOLIO OPTIMIZATION  -- exact solve + Monte Carlo sampling
    # ============================================================
    def portfolio_perf(w, mean_ret, cov, rf=RISK_FREE):
        ret = np.sum(mean_ret * w) * 252
        vol = np.sqrt(w.T @ cov @ w * 252)
        sharpe = (ret - rf) / vol
        return ret, vol, sharpe

    def neg_sharpe(w, mean_ret, cov, rf=RISK_FREE):
        return -portfolio_perf(w, mean_ret, cov, rf)[2]

    constraints = ({'type': 'eq', 'fun': lambda w: np.sum(w) - 1})
    bounds = tuple((0, 1) for _ in range(n_assets))
    init_guess = np.repeat(1/n_assets, n_assets)

    opt_result = minimize(neg_sharpe, init_guess, args=(mean_returns, cov_matrix),
                           method='SLSQP', bounds=bounds, constraints=constraints)
    optimal_weights_exact = opt_result.x

    results, weights_record = [], []
    for _ in range(NUM_RANDOM_PORTFOLIOS):
        w = np.random.random(n_assets)
        w /= w.sum()
        weights_record.append(w)
        ret, vol, sharpe = portfolio_perf(w, mean_returns, cov_matrix)
        results.append([ret, vol, sharpe])

    results_df = pd.DataFrame(results, columns=['Return', 'Volatility', 'Sharpe'])
    best_sampled_idx = results_df['Sharpe'].idxmax()
    optimal_weights_sampled = weights_record[best_sampled_idx]

    print("\n" + "="*60)
    print("OPTIMIZATION RESULTS (trained on in-sample period)")
    print("="*60)
    ret_e, vol_e, sharpe_e = portfolio_perf(optimal_weights_exact, mean_returns, cov_matrix)
    ret_s, vol_s, sharpe_s = portfolio_perf(optimal_weights_sampled, mean_returns, cov_matrix)
    print(f"{'Method':<25}{'Return':>10}{'Vol':>10}{'Sharpe':>10}")
    print(f"{'Exact (SLSQP)':<25}{ret_e*100:>9.2f}%{vol_e*100:>9.2f}%{sharpe_e:>10.2f}")
    print(f"{'Sampled (10k random)':<25}{ret_s*100:>9.2f}%{vol_s*100:>9.2f}%{sharpe_s:>10.2f}")
    print(f"Gap between exact and sampled Sharpe: {abs(sharpe_e - sharpe_s):.3f}  "
          f"(quantifies how good the random search approximation is)")

    for stock, we, ws in zip(stocks, optimal_weights_exact, optimal_weights_sampled):
        print(f"  {stock:<15} exact={we:.3f}   sampled={ws:.3f}")

    best_weights = optimal_weights_exact

    # ============================================================
    # 3. EQUAL-WEIGHT BENCHMARK (in-sample)
    # ============================================================
    equal_weights = np.repeat(1/n_assets, n_assets)
    ret_eq, vol_eq, sharpe_eq = portfolio_perf(equal_weights, mean_returns, cov_matrix)

    print("\n" + "="*60)
    print("BENCHMARK COMPARISON (in-sample)")
    print("="*60)
    print(f"{'Optimized':<15}{ret_e*100:>9.2f}%{vol_e*100:>9.2f}%{sharpe_e:>10.2f}")
    print(f"{'Equal-weight':<15}{ret_eq*100:>9.2f}%{vol_eq*100:>9.2f}%{sharpe_eq:>10.2f}")

    # ============================================================
    # 4. OUT-OF-SAMPLE BACKTEST
    # ============================================================
    def backtest(weights, returns_df, rf=RISK_FREE, label=""):
        daily = returns_df.dot(weights)
        cumulative = (1 + daily).cumprod()
        total_ret = cumulative.iloc[-1] - 1
        ann_ret = (1 + total_ret) ** (252/len(daily)) - 1
        ann_vol = daily.std() * np.sqrt(252)
        sharpe = (ann_ret - rf) / ann_vol
        roll_max = cumulative.cummax()
        dd = (cumulative - roll_max) / roll_max
        max_dd = dd.min()
        print(f"\n--- {label} ---")
        print(f"  Total Return:      {total_ret*100:.2f}%")
        print(f"  Annualized Return: {ann_ret*100:.2f}%")
        print(f"  Annualized Vol:    {ann_vol*100:.2f}%")
        print(f"  Sharpe Ratio:      {sharpe:.2f}")
        print(f"  Max Drawdown:      {max_dd*100:.2f}%")
        return daily, cumulative, {'total_ret': total_ret, 'ann_ret': ann_ret, 'ann_vol': ann_vol,
                                    'sharpe': sharpe, 'max_dd': max_dd}

    print("\n" + "="*60)
    print(f"OUT-OF-SAMPLE BACKTEST ({TEST_START} to {TEST_END})")
    print("="*60)
    daily_opt_test, cum_opt, stats_opt = backtest(best_weights, test_returns, label="Optimized Portfolio")
    daily_eq_test,  cum_eq,  stats_eq  = backtest(equal_weights, test_returns, label="Equal-Weight Benchmark")

    print(f"\nOut-of-sample Sharpe improvement: {stats_opt['sharpe'] - stats_eq['sharpe']:.2f}")
    if stats_opt['sharpe'] < stats_eq['sharpe']:
        print("NOTE: optimized portfolio underperformed equal-weight out-of-sample --")
        print("      this is a real, reportable finding (in-sample optimization can overfit).")

    # ============================================================
    # 5. HYPOTHESIS TEST: Is the out-of-sample Sharpe gap real?
    # ============================================================
    boot = block_bootstrap_sharpe_diff(daily_opt_test, daily_eq_test, rf=RISK_FREE,
                                        block_size=BOOTSTRAP_BLOCK_SIZE, n_boot=BOOTSTRAP_ITERS,
                                        seed=SEED)

    print("\n" + "="*60)
    print("HYPOTHESIS TEST: Out-of-Sample Sharpe Ratio Difference")
    print("="*60)
    print("H0: Optimized and Equal-Weight portfolios have equal Sharpe out-of-sample")
    print("H1: They differ (two-sided)")
    print(f"  Observed Sharpe gap (Optimized - Equal-Weight): {boot['observed_diff']:.3f}")
    print(f"  Block bootstrap 95% CI ({BOOTSTRAP_ITERS} resamples, {BOOTSTRAP_BLOCK_SIZE}-day blocks): "
          f"[{boot['ci_95'][0]:.3f}, {boot['ci_95'][1]:.3f}]")
    print(f"  Bootstrap p-value: {boot['p_value']:.3f}")
    if boot['ci_95'][0] <= 0 <= boot['ci_95'][1]:
        print("  -> Fail to reject H0: the observed Sharpe gap is statistically")
        print("     indistinguishable from zero. The in-sample outperformance did")
        print("     NOT survive out-of-sample -- consistent with overfitting rather")
        print("     than a real, exploitable edge.")
    else:
        print("  -> Reject H0 at 5%: the Sharpe gap appears to be a real effect, not noise.")

    # ============================================================
    # 6. MONTE CARLO FORWARD RISK SIMULATION (correlated GBM) -- CORRECTED
    # ============================================================
    mu_annual    = mean_returns.values * 252
    sigma_annual = train_returns.std().values * np.sqrt(252)
    corr = corr_matrix.values

    def monte_carlo_var(dollar_alloc, mu, sigma, corr, T_days, n_sims, confidence=0.95):
        dt = 1/252
        n_assets_ = len(mu)
        chol = np.linalg.cholesky(corr)
        # track RUPEE VALUE per asset per simulation, not raw prices
        values = np.tile(dollar_alloc, (n_sims, 1)).astype(float)

        for _ in range(T_days):
            Z = np.random.standard_normal((n_sims, n_assets_))
            correlated_Z = Z @ chol.T
            growth = np.exp((mu - 0.5*sigma**2)*dt + sigma*np.sqrt(dt)*correlated_Z)
            values *= growth   # each asset's allocation grows by its own simulated return

        portfolio_values = values.sum(axis=1)
        initial_value = dollar_alloc.sum()
        pnl = portfolio_values - initial_value
        var_abs = -np.percentile(pnl, (1-confidence)*100)   # loss, not raw value -- fixes original bug
        var_pct = var_abs / initial_value
        return portfolio_values, var_abs, var_pct

    dollar_alloc = best_weights * INITIAL_INVESTMENT   # weights -> rupee allocation -- fixes original bug
    mc_values, mc_var_abs, mc_var_pct = monte_carlo_var(
        dollar_alloc, mu_annual, sigma_annual, corr,
        T_days=MC_DAYS, n_sims=MC_SIMULATIONS, confidence=CONFIDENCE
    )

    print("\n" + "="*60)
    print(f"MONTE CARLO {MC_DAYS}-DAY VaR ({int(CONFIDENCE*100)}%) -- {MC_SIMULATIONS} correlated GBM paths")
    print("="*60)
    print(f"  Initial Investment:  Rs {INITIAL_INVESTMENT:,.0f}")
    print(f"  Expected Value ({MC_DAYS}d): Rs {mc_values.mean():,.0f}")
    print(f"  Monte Carlo VaR:     Rs {mc_var_abs:,.0f}  ({mc_var_pct*100:.2f}% of portfolio)")

    # ============================================================
    # 7. PARAMETRIC (VARIANCE-COVARIANCE) VaR -- for comparison
    # ============================================================
    port_daily_vol = np.sqrt(best_weights @ cov_matrix.values @ best_weights)
    port_mean_daily = np.sum(mean_returns.values * best_weights)
    z_score = 1.645  # 95% one-tailed
    scale = np.sqrt(MC_DAYS)
    param_var_pct = (z_score * port_daily_vol * scale) - (port_mean_daily * MC_DAYS)
    param_var_abs = param_var_pct * INITIAL_INVESTMENT

    print(f"\nParametric (Variance-Covariance) VaR:")
    print(f"  VaR: Rs {param_var_abs:,.0f}  ({param_var_pct*100:.2f}% of portfolio)")

    # ============================================================
    # 8. HISTORICAL SIMULATION VaR -- for comparison
    # ============================================================
    port_hist_daily = train_returns.dot(best_weights)
    n_hist = len(port_hist_daily)
    hist_n_day_returns = []
    for _ in range(5000):
        idx = np.random.randint(0, n_hist - MC_DAYS)
        block = port_hist_daily.iloc[idx: idx+MC_DAYS]
        hist_n_day_returns.append((1+block).prod() - 1)
    hist_n_day_returns = np.array(hist_n_day_returns)
    hist_var_pct = -np.percentile(hist_n_day_returns, (1-CONFIDENCE)*100)
    hist_var_abs = hist_var_pct * INITIAL_INVESTMENT

    print(f"\nHistorical Simulation VaR (bootstrapped {MC_DAYS}-day blocks):")
    print(f"  VaR: Rs {hist_var_abs:,.0f}  ({hist_var_pct*100:.2f}% of portfolio)")

    # ============================================================
    # 9. THREE-METHOD VaR COMPARISON TABLE
    # ============================================================
    print("\n" + "="*60)
    print(f"VaR METHOD COMPARISON ({MC_DAYS}-day, {int(CONFIDENCE*100)}% confidence)")
    print("="*60)
    print(f"{'Method':<25}{'VaR %':>10}{'VaR (Rs)':>15}")
    print(f"{'Monte Carlo (GBM)':<25}{mc_var_pct*100:>9.2f}%{mc_var_abs:>15,.0f}")
    print(f"{'Parametric':<25}{param_var_pct*100:>9.2f}%{param_var_abs:>15,.0f}")
    print(f"{'Historical Simulation':<25}{hist_var_pct*100:>9.2f}%{hist_var_abs:>15,.0f}")

    # ============================================================
    # 10. NORMALITY CHECK -- explains why the 3 VaR methods converge
    # ============================================================
    print("\n" + "="*60)
    print("NORMALITY CHECK (Jarque-Bera)")
    print("="*60)
    normality_check(port_hist_daily, label="in-sample portfolio daily returns")

    # ============================================================
    # 11. PLOTS
    # ============================================================
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))

    sc = axes[0,0].scatter(results_df['Volatility'], results_df['Return'], c=results_df['Sharpe'],
                            cmap='viridis', s=8, alpha=0.4)
    axes[0,0].scatter(vol_e, ret_e, color='red', s=120, label='Exact Optimum', zorder=5)
    axes[0,0].scatter(vol_eq, ret_eq, color='black', marker='x', s=120, label='Equal-Weight', zorder=5)
    axes[0,0].set_xlabel("Volatility"); axes[0,0].set_ylabel("Return"); axes[0,0].legend()
    axes[0,0].set_title("Efficient Frontier")

    (cum_opt*INITIAL_INVESTMENT).plot(ax=axes[0,1], label='Optimized')
    (cum_eq*INITIAL_INVESTMENT).plot(ax=axes[0,1], label='Equal-Weight')
    axes[0,1].axhline(INITIAL_INVESTMENT, color='gray', linestyle='--')
    axes[0,1].set_title("Out-of-Sample Backtest"); axes[0,1].legend()

    axes[1,0].hist(mc_values, bins=60, alpha=0.7)
    axes[1,0].axvline(INITIAL_INVESTMENT - mc_var_abs, color='red', linestyle='--',
                       label=f'{int(CONFIDENCE*100)}% VaR')
    axes[1,0].set_title(f"Monte Carlo {MC_DAYS}-Day Portfolio Value Distribution"); axes[1,0].legend()

    methods = ['Monte Carlo', 'Parametric', 'Historical']
    var_pcts = [mc_var_pct*100, param_var_pct*100, hist_var_pct*100]
    axes[1,1].bar(methods, var_pcts, color=['steelblue','orange','green'])
    axes[1,1].set_ylabel("VaR (%)"); axes[1,1].set_title("VaR Method Comparison")

    plt.tight_layout()
    plt.savefig('output.png', dpi=100)   # saves in the same folder you run the script from
    print("\nChart saved to output.png")


if __name__ == "__main__":
    raw = load_data(use_live=True)
    run(raw)
