import numpy as np
import pandas as pd
import yfinance as yf

# same stocks
stocks = ['RELIANCE.NS','TCS.NS','INFY.NS','HDFCBANK.NS']

data = yf.download(stocks, start="2020-01-01")['Close']

# calculate returns
returns = data.pct_change().dropna()

mean_returns = returns.mean()
cov_matrix = returns.cov()

# ----- INPUT WEIGHTS FROM OPTIMIZATION -----

weights = np.array([0.32,0.28,0.21,0.19])  
# replace with the weights your model printed

# ----- PORTFOLIO RETURN -----

portfolio_return = np.sum(mean_returns * weights) * 252

# ----- PORTFOLIO RISK (VOLATILITY) -----

portfolio_volatility = np.sqrt(
    np.dot(weights.T, np.dot(cov_matrix * 252, weights))
)

# ----- SHARPE RATIO -----

sharpe = portfolio_return / portfolio_volatility

print("Portfolio Expected Return:", round(portfolio_return,4))
print("Portfolio Risk (Volatility):", round(portfolio_volatility,4))
print("Sharpe Ratio:", round(sharpe,4))