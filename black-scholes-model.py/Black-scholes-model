# ============================================================
# B. BLACK-SCHOLES CORE + GREEKS + IMPLIED VOLATILITY
# ============================================================
def black_scholes(S, K, T, r, sigma, q=0.0, option_type="call"):
    if T <= 0 or sigma <= 0 or S <= 0 or K <= 0:
        raise ValueError("S, K, T, sigma must all be positive")
    d1 = (np.log(S/K) + (r - q + 0.5*sigma**2)*T) / (sigma*np.sqrt(T))
    d2 = d1 - sigma*np.sqrt(T)
    if option_type == "call":
        price = S*np.exp(-q*T)*norm.cdf(d1) - K*np.exp(-r*T)*norm.cdf(d2)
    elif option_type == "put":
        price = K*np.exp(-r*T)*norm.cdf(-d2) - S*np.exp(-q*T)*norm.cdf(-d1)
    else:
        raise ValueError("option_type must be 'call' or 'put'")
    return price


def bs_greeks(S, K, T, r, sigma, q=0.0, option_type="call"):
    d1 = (np.log(S/K) + (r - q + 0.5*sigma**2)*T) / (sigma*np.sqrt(T))
    d2 = d1 - sigma*np.sqrt(T)
    pdf_d1 = norm.pdf(d1)
    if option_type == "call":
        delta = np.exp(-q*T)*norm.cdf(d1)
        theta = (-S*pdf_d1*sigma*np.exp(-q*T)/(2*np.sqrt(T))
                 - r*K*np.exp(-r*T)*norm.cdf(d2)
                 + q*S*np.exp(-q*T)*norm.cdf(d1))
        rho = K*T*np.exp(-r*T)*norm.cdf(d2)
    else:
        delta = -np.exp(-q*T)*norm.cdf(-d1)
        theta = (-S*pdf_d1*sigma*np.exp(-q*T)/(2*np.sqrt(T))
                 + r*K*np.exp(-r*T)*norm.cdf(-d2)
                 - q*S*np.exp(-q*T)*norm.cdf(-d1))
        rho = -K*T*np.exp(-r*T)*norm.cdf(-d2)
    gamma = np.exp(-q*T)*pdf_d1 / (S*sigma*np.sqrt(T))
    vega = S*np.exp(-q*T)*pdf_d1*np.sqrt(T)
    return {'delta': delta, 'gamma': gamma, 'vega': vega, 'theta': theta, 'rho': rho}


def implied_volatility(market_price, S, K, T, r, q=0.0, option_type="call"):
    """Back out IV from a market price via Brent's method (bounded, derivative-free)."""
    if option_type == "call":
        intrinsic = max(S*np.exp(-q*T) - K*np.exp(-r*T), 0)
        upper = S*np.exp(-q*T)
    else:
        intrinsic = max(K*np.exp(-r*T) - S*np.exp(-q*T), 0)
        upper = K*np.exp(-r*T)
    if market_price < intrinsic - 1e-8 or market_price > upper + 1e-8:
        return np.nan  # violates no-arbitrage bounds, can't invert

    def obj(sigma):
        return black_scholes(S, K, T, r, sigma, q, option_type) - market_price

    try:
        return brentq(obj, 1e-4, 5.0, xtol=1e-8)
    except ValueError:
        return np.nan


# ============================================================
# C. GARCH(1,1) vs. HISTORICAL VOLATILITY -- WALK-FORWARD + DIEBOLD-MARIANO
# ============================================================
def garch_vol_forecast(returns_pct_train, horizon_days=VOL_HORIZON):
    """GARCH(1,1) forecast of annualized volatility over the next horizon_days."""
    am = arch_model(returns_pct_train, vol='Garch', p=1, q=1, dist='normal')
    res = am.fit(disp='off')
    fcast = res.forecast(horizon=horizon_days, reindex=False)
    var_path = fcast.variance.values[-1, :]
    return np.sqrt(var_path.mean() * 252) / 100


def historical_vol_forecast(returns_decimal_train, window=HIST_VOL_WINDOW):
    """Naive benchmark: trailing rolling-window realized vol, annualized."""
    return returns_decimal_train[-window:].std() * np.sqrt(252)


def realized_vol(returns_decimal_future, horizon_days):
    """The forecast TARGET: actual realized vol over the next horizon_days."""
    return returns_decimal_future[:horizon_days].std() * np.sqrt(252)


def diebold_mariano_test(errors_a, errors_b, h=1, loss='squared'):
    """
    H0: forecast A and forecast B have equal expected loss (equal accuracy).
    H1: they differ (two-sided).
    Newey-West HAC variance with (h-1) Bartlett-weighted lags accounts for
    autocorrelation from overlapping forecast horizons.
    """
    e_a = np.asarray(errors_a); e_b = np.asarray(errors_b)
    d = (e_a**2 - e_b**2) if loss == 'squared' else (np.abs(e_a) - np.abs(e_b))
    n = len(d)
    d_mean = d.mean()
    var_d = np.var(d, ddof=0)
    for lag in range(1, h):
        cov = np.cov(d[lag:], d[:-lag])[0, 1]
        var_d += 2 * (1 - lag/h) * cov
    var_d = max(var_d, 1e-12)
    dm_stat = d_mean / np.sqrt(var_d / n)
    p_value = 2 * (1 - stats.norm.cdf(np.abs(dm_stat)))
    return {'dm_stat': dm_stat, 'p_value': p_value, 'mean_loss_diff': d_mean}


def walk_forward_vol_eval(returns_decimal, window=VOL_WINDOW, horizon=VOL_HORIZON,
                            step=VOL_STEP, hist_window=HIST_VOL_WINDOW):
    """
    At each forecast origin: fit GARCH(1,1) and a naive rolling-vol
    benchmark on the trailing `window` days, forecast the next `horizon`
    days' realized vol both ways, then compare to what actually happened.
    Returns per-method forecast error arrays for the Diebold-Mariano test.
    """
    n = len(returns_decimal)
    garch_errors, hist_errors, origins = [], [], []
    for origin in range(window, n - horizon, step):
        train = returns_decimal[origin-window:origin]
        future = returns_decimal[origin:origin+horizon]
        g_fcast = garch_vol_forecast(train*100, horizon_days=horizon)
        h_fcast = historical_vol_forecast(train, window=hist_window)
        actual = realized_vol(future, horizon)
        garch_errors.append(g_fcast - actual)
        hist_errors.append(h_fcast - actual)
        origins.append(origin)
    return np.array(garch_errors), np.array(hist_errors), origins


# ============================================================
# D. IMPLIED VOLATILITY SMILE + SIGNIFICANCE TEST
#
# NOTE ON DATA SOURCE: yfinance does not reliably provide NSE index/stock
# option chains. Supply your own option chain as a CSV with columns:
#   strike, market_price, option_type   (option_type = 'call' or 'put')
# for a single underlying, single expiry, single snapshot in time.
# Source options: a broker API you have access to (e.g. Zerodha Kite
# Connect, Upstox), or NSE's own option-chain data if you can pull it.
# ============================================================
def build_smile(option_chain_csv, S, T, r, q=DIVIDEND_YIELD):
    """
    option_chain_csv: path to CSV with columns strike, market_price, option_type
    S: underlying spot price at the time the chain was snapshotted
    T: time to expiry in years (e.g. days_to_expiry / 365)
    """
    chain = pd.read_csv(option_chain_csv)
    chain['iv'] = chain.apply(
        lambda row: implied_volatility(row['market_price'], S, row['strike'], T, r, q, row['option_type']),
        axis=1
    )
    chain = chain.dropna(subset=['iv'])
    return chain


def smile_regression(strikes, ivs, S):
    """
    Regress IV on moneyness (log(K/S), linear = skew) and moneyness^2
    (quadratic = curvature).
    H0 (skew):      beta1 = 0  (no linear tilt -- BS assumption holds)
    H0 (curvature): beta2 = 0  (no convex smile shape)
    """
    moneyness = np.log(np.asarray(strikes) / S)
    X = np.column_stack([np.ones_like(moneyness), moneyness, moneyness**2])
    y = np.asarray(ivs)
    beta, _, _, _ = np.linalg.lstsq(X, y, rcond=None)
    n, k = X.shape
    resid = y - X @ beta
    dof = n - k
    sigma2 = (resid @ resid) / dof
    cov_beta = sigma2 * np.linalg.inv(X.T @ X)
    se = np.sqrt(np.diag(cov_beta))
    t_stats = beta / se
    p_values = 2 * (1 - stats.t.cdf(np.abs(t_stats), dof))
    ss_res = resid @ resid
    ss_tot = ((y - y.mean())**2).sum()
    r2 = 1 - ss_res/ss_tot
    return {'intercept': beta[0], 'skew_coef': beta[1], 'curvature_coef': beta[2],
            'skew_p': p_values[1], 'curvature_p': p_values[2], 'r2': r2}


# ============================================================
# E. PRICING ACCURACY: GARCH-VOL vs HISTORICAL-VOL AGAINST REAL MARKET PRICES
# ============================================================
def compare_pricing_accuracy(errors_garch, errors_hist):
    """
    Paired Wilcoxon signed-rank test on absolute pricing errors.
    H0: median absolute pricing error is equal between the two vol inputs.
    """
    abs_g = np.abs(errors_garch)
    abs_h = np.abs(errors_hist)
    stat, p = stats.wilcoxon(abs_g, abs_h)
    return {'median_abs_err_garch': np.median(abs_g), 'median_abs_err_hist': np.median(abs_h),
            'wilcoxon_stat': stat, 'p_value': p}


